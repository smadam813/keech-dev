# Auto detect text files and perform LF normalization
* text=auto

# Source
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf

# Content
*.md text eol=lf
*.mdx text eol=lf

# Config
*.yml text eol=lf
*.yaml text eol=lf

# Fonts
*.woff2 binary

# Images
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Lock file — exact, no diff noise
package-lock.json binary
