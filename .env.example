# Copy to .env.local (gitignored). Both values come from the Upstash console.
#
# Used only for post view counts (src/lib/redis.ts reads them via Redis.fromEnv()).
# Without them the /api/views routes log "[views] Redis error:" and view counts
# silently fail. Everything else on the site, including `npm run build`, works without them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
